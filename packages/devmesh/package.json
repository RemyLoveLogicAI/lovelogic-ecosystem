{
  "name": "@lovelogic/devmesh",
  "version": "0.1.0",
  "description": "DevMesh - Unified CLI for orchestrating AI development platforms",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ll": "./dist/index.js",
    "lovelogic": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
